NODE_ENV=development
PORT=3000
# Neon: use the pooled connection string, keep it secret (Render env var only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
FRONTEND_URL=http://localhost:5173
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_DAYS=14
# 'lax' when the frontend proxies /api (recommended); 'none' only for direct cross-site calls
COOKIE_SAMESITE=lax
LOG_LEVEL=info
# Seeding only (never commit a real value):
DEMO_PASSWORD=
